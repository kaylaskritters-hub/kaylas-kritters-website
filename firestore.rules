rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== JOBS COLLECTION =====

    // READ access: Public reads active jobs, admin reads all jobs
    match /jobs/{jobId} {
      allow read: if
        resource.data.active == true ||
        (request.auth != null && request.auth.uid == "p7AzNLbUlfPy3agBd1mMtePsxPa2");

      // Admin-only WRITE access: Only Kayla (UID: p7AzNLbUlfPy3agBd1mMtePsxPa2) can create, update, or delete jobs
      allow create, update, delete: if
        request.auth != null &&
        request.auth.uid == "p7AzNLbUlfPy3agBd1mMtePsxPa2";
    }

    // ===== DENY EVERYTHING ELSE =====
    // All other access to Firestore is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
